{
  "name": "jjkccmodmanager",
  "productName": "JJK CC Mod Manager",
  "version": "0.3.0",
  "description": "Mod Manager App for Jujutsu Kaisen CC",
  "main": "main.js",
  "scripts": {
    "postinstall": "npm --prefix ./AssetRegistryPatcher install && npm --prefix ./CookedDatatablePatcher install",
    "prestart": "npm run patcher:build",
    "patcher:build": "npm --prefix ./AssetRegistryPatcher run build && npm --prefix ./CookedDatatablePatcher run build",
    "start": "electron .",
    "prebuild": "npm run patcher:build",
    "build": "electron-builder --win --x64",
    "prebuild:portable": "npm run patcher:build",
    "build:portable": "electron-builder --win portable --x64"
  },
  "build": {
    "appId": "com.jjkcc.modmanager",
    "productName": "JJK CC Mod Manager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "scripts/**",
      "renderer/**",
      "data/**",
      "tools/**",
      "node_modules/**"
    ],
    "extraResources": [
      {
        "from": "tools",
        "to": "tools"
      },
      {
        "from": "data",
        "to": "data"
      },
      {
        "from": "install",
        "to": "install"
      },
      {
        "from": "AssetRegistryPatcher/dist",
        "to": "AssetRegistryPatcher/dist"
      },
      {
        "from": "AssetRegistryPatcher/package.json",
        "to": "AssetRegistryPatcher/package.json"
      },
      {
        "from": "CookedDatatablePatcher/dist",
        "to": "CookedDatatablePatcher/dist"
      },
      {
        "from": "CookedDatatablePatcher/package.json",
        "to": "CookedDatatablePatcher/package.json"
      },
      {
        "from": "CookedDatatablePatcher/mappings.usmap",
        "to": "CookedDatatablePatcher/mappings.usmap"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "renderer/assets/icon.ico",
      "signAndEditExecutable": false
    },
    "fileAssociations": [
      {
        "ext": "jjkmod",
        "name": "JJK Mod Package",
        "description": "Jujutsu Kaisen Cursed Clash mod package",
        "role": "Editor",
        "icon": "renderer/assets/icon.ico"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "renderer/assets/icon.ico",
      "uninstallerIcon": "renderer/assets/icon.ico",
      "installerHeaderIcon": "renderer/assets/icon.ico"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "adm-zip": "^0.5.17"
  },
  "devDependencies": {
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JJKCursedClashModding/Mod-Manager.git"
  },
  "bugs": {
    "url": "https://github.com/JJKCursedClashModding/Mod-Manager/issues"
  },
  "homepage": "https://github.com/JJKCursedClashModding/Mod-Manager#readme"
}
